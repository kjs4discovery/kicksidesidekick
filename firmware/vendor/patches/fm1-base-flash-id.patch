-        flash_ok = FL_FAR(fl_jedec_ram)() == 0x856014u;   /* the expected 1 MiB part, else RAM only */
+        {                                           /* fm1-accompaniment: both known 1 MiB parts, else RAM only */
+            uint32_t id = FL_FAR(fl_jedec_ram)();   /* (0x856014 Puya; 0xB36014 UCUN UC25HQ80, units from late 2026) */
