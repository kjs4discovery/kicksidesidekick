     bt_stats();
 }
 
+
+/* TEMPORARY (M9 Part 0): the time of a style change, measured with the player playing on */
+static struct song m9_tmp;
+static void m9_measure(void)
+{
+    uint32_t sty, ms0 = plat_ms();
+    const struct store_entry *e = store_get(order[bt.list[bt.prog]]);
+    uint32_t blk0 = player_stats.blocks;
+    player_stats.m9[70] = (uint32_t)(uintptr_t)e;
+    player_stats.m9[71] = e ? e->len : 0;
+    player_stats.m9[72] = bt.list[bt.prog];
+    player_stats.m9[73] = order[bt.list[bt.prog]];
+    player_stats.m9[74] = (uint32_t)(uintptr_t)store_file(e);
+    for (sty = 0; sty < BT_STYLES; sty++) {
+        uint32_t t0 = plat_ms(), t1, t2, t3, t4, l, at = 0, b0 = player_stats.blocks, rm0 = player_stats.render_max;
+        int r = song_open(&m9_tmp, store_file(e), e->len, dec + BT_SONG_ROOM / 2u, BT_SONG_ROOM / 2u);
+        t1 = plat_ms();
+        if (!r)
+            r = song_restyle(&m9_tmp, BT_STYLE_OF[sty], sty == BT_WALTZ ? 3u : 4u);
+        t2 = plat_ms();
+        for (l = 0; l < SONG_LAYERS && !r; l++) {
+            if (m9_tmp.layer[l].variants) {
+                uint32_t n = m9_tmp.layer[l].need * 8u;
+                if (at + n <= BT_SONG_ROOM / 2u)
+                    r = song_build(&m9_tmp, l, 1u, dec + BT_SONG_ROOM / 2u + at, n);
+                at += n;
+            }
+        }
+        t3 = plat_ms();
+        at = 0;
+        for (l = 0; l < SONG_LAYERS && !r; l++)   /* only the levels again (a complexity change): level 2 */
+            if (m9_tmp.layer[l].variants) {
+                uint32_t n = m9_tmp.layer[l].need * 8u;
+                if (at + n <= BT_SONG_ROOM / 2u)
+                    r = song_build(&m9_tmp, l, 2u, dec + BT_SONG_ROOM / 2u + at, n);
+                at += n;
+            }
+        t4 = plat_ms();
+        for (l = 0, at = 0; l < SONG_LAYERS; l++)
+            at += m9_tmp.layer[l].need * 8u;
+        player_stats.m9[sty * 6u + 0u] = t1 - t0;
+        player_stats.m9[sty * 6u + 1u] = t2 - t1;
+        player_stats.m9[sty * 6u + 2u] = t3 - t2;
+        player_stats.m9[sty * 6u + 3u] = t4 - t3;
+        player_stats.m9[sty * 6u + 4u] = at;
+        player_stats.m9[sty * 6u + 5u] = (uint32_t)r;
+        (void)b0; (void)rm0;
+    }
+    player_stats.m9[78] = plat_ms() - ms0;               /* all 11, ms */
+    player_stats.m9[79] = player_stats.blocks - blk0;    /* blocks the player made meanwhile (256 frames each) */
+}
+
 /* the play screen's own (before input_play): K4 the melody sound, LFO (no melody layer): the melody is yours */
 static void bt_play_input(uint32_t down)
 {
     int32_t d = plat_enc(EN_K4);
+    if (plat_enc(EN_K2))
+        m9_measure();
     if (d) {
         int32_t n = (int32_t)vsynth_presets();
         bt_sound((uint32_t)(((int32_t)bt.sound + d) % n + n));
